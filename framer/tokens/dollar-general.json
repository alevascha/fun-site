    "principles": [
      {
        "title": "Value is the message",
        "body": "Prices, deals and coupons get the strongest type and the yellow marker. Everything else steps back."
      },
      {
        "title": "Authorable, not custom",
        "body": "Every component maps 1:1 to an AEM component with the same props, so campaigns ship without engineering tickets."
      },
      {
        "title": "Fast on every phone",
        "body": "Flat surfaces, system shadows and one web font keep pages light for customers on older devices."
      }
    ],
    "dos": [
      {
        "kind": "color",
        "do": "Use DG Yellow as a highlight behind text or as a badge, paired with black.",
        "dont": "Set white or yellow text on yellow; it fails contrast immediately."
      },
      {
        "kind": "primary",
        "do": "One black primary button per module, like “Start Shopping”.",
        "dont": "Two primary buttons in a promo tile."
      },
      {
        "kind": "radius",
        "do": "Keep the 4px corner on buttons and inputs for the utilitarian retail feel.",
        "dont": "Round buttons into pills on some modules and not others."
      },
      {
        "kind": "copy",
        "do": "Lead with the value: “$5 off $25”, then the action.",
        "dont": "Bury the price in body copy below the button."
      }
    ],
    "a11y": [
      "Yellow #FFF200 is never a text color: it's a background for black text (17.9:1).",
      "Link blue #2A77BD passes AA on white for body text and gets an underline on hover and focus.",
      "Prices are real text with screen-reader friendly formats (“2 for $7”), not images.",
      "AEM authors pick from approved color pairs only, so pages can't ship failing contrast.",
      "Coupons expose clip state with aria-pressed and an icon, not only a color change."
    ]
  }

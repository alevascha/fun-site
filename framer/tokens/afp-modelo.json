    "principles": [
      {
        "title": "Plain language first",
        "body": "Pension terms are explained in the interface: helper text, tooltips and examples sit next to every financial field."
      },
      {
        "title": "Calm confidence",
        "body": "Generous spacing, soft lilac surfaces and one green action keep long forms from feeling stressful."
      },
      {
        "title": "One library, three products",
        "body": "Site, member portal and campaigns share tokens and components, so a change ships everywhere at once."
      }
    ],
    "dos": [
      {
        "kind": "contrast",
        "do": "Use Modelo Green as a fill with 18px+ bold white text, or the darker #4E7300 for small text.",
        "dont": "Put 14px white text on #81BD00; it only reaches about 2.3:1."
      },
      {
        "kind": "primary",
        "do": "Keep one green primary per step of a form.",
        "dont": "Show “Cámbiate” and “Simula” as two green buttons side by side."
      },
      {
        "kind": "spacing",
        "do": "Use the 8px grid and 24–32px between form groups.",
        "dont": "Crowd fields together to fit a long form on one screen."
      },
      {
        "kind": "copy",
        "do": "Write like a person: “Simula tu pensión”.",
        "dont": "Use legal jargon in buttons and headings."
      }
    ],
    "a11y": [
      "Small green text uses #4E7300 (5.6:1 on white); #81BD00 is reserved for fills and large text.",
      "Amounts are formatted with the PEN currency and read correctly by screen readers.",
      "Long forms are split into labelled steps with a progress indicator and saved state.",
      "Every tooltip is also reachable by keyboard and has its text available on tap.",
      "Error messages explain how to fix the problem in plain Spanish, next to the field."
    ]
  }

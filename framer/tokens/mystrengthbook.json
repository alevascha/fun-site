    "principles": [
      {
        "title": "Data first, chrome last",
        "body": "Coaches live in tables and charts. Surfaces stay quiet so numbers like load, RPE and volume carry the hierarchy."
      },
      {
        "title": "Themeable by design",
        "body": "Partner brands swap the gradient, logo and two accent tokens; spacing, type and components stay identical."
      },
      {
        "title": "Motion that confirms",
        "body": "Short, eased transitions confirm saves and logged sets. Nothing decorative runs while an athlete trains."
      }
    ],
    "dos": [
      {
        "kind": "primary",
        "do": "Use the teal→green gradient for the single most important action on a screen.",
        "dont": "Put the gradient on every button; it stops meaning “next step”."
      },
      {
        "kind": "contrast",
        "do": "Keep set and rep numbers in Ink on white for gym lighting and glare.",
        "dont": "Show training data in Slate on Mist; it washes out on a phone at the rack."
      },
      {
        "kind": "radius",
        "do": "Keep buttons and chips as pills and cards at 20px.",
        "dont": "Mix square and pill buttons in the same flow."
      },
      {
        "kind": "copy",
        "do": "Label actions with the coach's verb: “Assign program”, “Log set”.",
        "dont": "Use generic labels like “OK” or “Submit”."
      }
    ],
    "a11y": [
      "White on the gradient only reaches 3.5:1 on teal and 1.8:1 on green, so gradient buttons use 18px bold labels kept on the teal half, and small text never sits on the green end.",
      "Every chart has a table view and labelled values, so data isn't locked inside color.",
      "Rest timer and set completion are announced with aria-live, not just animated.",
      "Inputs for weight and reps use numeric keyboards and 44px minimum targets.",
      "Focus ring uses Teal #0097B2 with a 2px offset on every interactive element."
    ]
  }
